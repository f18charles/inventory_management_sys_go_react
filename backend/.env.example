# Application
APP_ENV=development          # development | production
APP_PORT=8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=inventory
DB_SSLMODE=disable

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRATION=24h