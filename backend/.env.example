# Application
APP_ENV=development          # development | production
APP_PORT=8080

# Application database (Neon PostgreSQL)
# Preferred connection string for running the server and applying migrations.
# Neon requires TLS, so keep sslmode=require.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require

# Local test database (used by `go test` / `make test`)
# Point this at your local PostgreSQL instance, never at Neon.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory_test?sslmode=disable

# Fallback discrete database settings.
# Only used when DATABASE_URL / TEST_DATABASE_URL are unset.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=inventory
DB_SSLMODE=disable

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRATION=24h
